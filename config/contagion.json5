{
	// Time in seconds until the infection kills the player | default: 600
	"infectionDuration": 600,
	// Base chance in % an attack will infect the player | default: 80 | range: 0 - 100
	"baseInfectionChance": 80,
	// Minimum infection chance in % (even with armor the chance can not be lower than this minimum) | default: 10 | range: 0 - 100
	"minimumInfectionChance": 10,
	// If true, wearing armor will lower the infection chance (full Netherite will lower the chance by 60%)
	"armorLowersInfectionChance": true,
	// If true, random symptoms can occur when infected
	"enableRandomSymptoms": true,
	// If true, the random effects weakness and slowness effects will last until the infection is cured or drinking milk
	"infiniteWeaknessAndSlowness": false,
	// Time in seconds a random symptom will last | default: 30
	"randomSymptomsDuration": 30,
	// Chance in % a random symptom can occur when infected | default: 3 | range: 0 - 100
	"randomSymptomsChance": 3,
	// Time in seconds after drinking a cure the player is immune to new infections | default: 120
	"immunityDuration": 120,
	// If true, drinking milk will cure the player if infected | default: false
	"milkCuresInfection": false,
	// If true, holding a totem prevents the player from dying when the infection timer expires | default: true
	"totemPreventsDyingFromInfection": true,
	// If true, Iron Golems will attack infected players
	"ironGolemAttacksInfected": false,
	// If true, infected players can infect other players by attacking them
	"allowPlayersToInfectPlayers": false,
	// If true, infected players can infect Villagers by attacking them
	"allowPlayersToInfectVillagers": false,
	// If true, Zombies can infect Villagers by attacking them
	"allowZombiesToInfectVillagers": false,
	// If true, an infected Villager will convert into a Zombie Entity when it dies from the infection
	"villagerZombieConversion": true,
	// If true, enables airborne (aerosol) transmission of infection between nearby players
	"enableAirborneInfection": false,
	// If true, Villages are also able to transmit and receive the infection via airborne (aerosol) transmission
	"allowAirborneInfectionForVillagers": false,
	// If true, Villagers flee from infectious entities
	"villagerFleeFromInfectiousEntities": true,
	// If true, Zombies will spawn with the infectious effect (as Spreaders)
	"allowZombiesToSpawnInfectious": false,
	// Chance (X in 1000) for a Zombie to spawn with the infectious effect (as Spreaders) | default: 155 | range: 1 - 1000
	"chanceForZombieToSpawnInfectious": 155,
	// Maximum radius (in blocks) for aerosol transmission of infection via breathing/spores | default: 6 | min: 1
	"airborneInfectionRadius": 6,
	// Maximum infection chance at (directly adjacent a spreader) for aerosol transmission | default: 50 | range: 0 - 100
	"airborneMaxChance": 50,
	// Base drop chance for Contagious Flesh from zombie-type mobs (0.0 to 1.0) | default: 0.075
	"contagiousFleshDropChance": 0.075,
	// Looting bonus for Contagious Flesh drops per Looting level (0.0 to 1.0) | default: 0.025
	"contagiousFleshLootingBonus": 0.025,
	// If true, eating a golden apple will cure the player's infection
	"goldenAppleCuresInfection": false,
	// If true, eating an enchanted golden apple (god apple) will cure the player's infection
	"enchantedGoldenAppleCuresInfection": false,
	// If true, writes debug messages to the log
	"enableDebugMessages": false,
	// [Client] If true, displays the current protection value in the HUD | default: true
	"displayCurrentInfectionProtection": true,
	// [Client] Move the displayed protection value in the HUD in X-direction | default: 0
	"deltaX": 0,
	// [Client] Move the displayed protection value in the HUD in Y-direction | default: 0
	"deltaY": 0
}